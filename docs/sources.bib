@misc{terna2026dcqueue,
  author       = {{Terna}},
  title        = {Data centre connection requests on the Italian transmission grid},
  howpublished = {Reported via Il Sole 24 ORE and QualEnergia},
  year         = {2026},
  note         = {82 GW of data-centre connection requests against 1.5--2 GW the TSO expects to materialise by 2030 --- Terna itself describes the request volume as roughly forty times the realistic figure and attributes the gap to speculation. 342 requests in total; 14 authorised and contracted projects totalling 1.53 GW as of 2025-10-31, all in Lombardy. Quantifies speculative oversubscription of connection queues, NOT physical grid capability.}
}

@misc{energinet2026pause,
  author       = {{Energinet}},
  title        = {National pause on new grid connections},
  howpublished = {Announced 2026-03-02; reported via CNBC, reNEWS and Plesner},
  year         = {2026},
  note         = {Denmark halted new grid connections on 2026-03-02, initially for three months, after the connection queue reached roughly 60 GW against a national peak demand of about 7 GW. Data centres account for roughly 15 GW of the queue. First-come-first-served for large loads was abolished on 2026-02-01 in favour of pooled evaluation by project maturity and grid-friendliness.}
}

@misc{cru2025dcconnection,
  author       = {{Commission for Regulation of Utilities (Ireland)}},
  title        = {Decision on large energy user electricity grid connections},
  howpublished = {CRU decision, December 2025},
  year         = {2025},
  note         = {Ends the de-facto moratorium in place since 2021 by imposing conditions instead: new data centres must install dispatchable on-site generation or storage matching their full import capacity, and source 80\% of annual demand from additional Irish renewables over a six-year glide path. Basis for Ireland's connection-pipeline tightness in this model.}
}

@misc{tennet2026queue,
  author       = {{TenneT}},
  title        = {Dutch transmission grid connection queue for large loads},
  howpublished = {Reported figures for the TenneT NL connection queue},
  year         = {2026},
  note         = {212 connection requests totalling 38 GW against a national peak of roughly 19--22 GW. Amsterdam imposed a moratorium on new data centres in April 2025 running to at least 2030 and possibly 2035; TenneT reports no additional large-load hosting capacity in much of Noord-Holland for around ten years.}
}

