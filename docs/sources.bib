@misc{eudelegatedreg20241364,
  author = {{European Commission}},
  title  = {Commission Delegated Regulation (EU) 2024/1364 of 14 March 2024 supplementing Directive (EU) 2023/1791 as regards a common Union
            rating scheme for data centres},
  year   = {2024},
  month  = mar,
  note   = {ELI: data.europa.eu/eli/reg\_del/2024/1364/oj. Article 2(14) defines "installed information technology power demand" as the
            nominal power demand of equipment installed in the computer room floor area (nameplate sum); Article 2(15) defines "rated
            information technology load" as the maximum load the facility's power and cooling infrastructure can carry. The two are
            distinct quantities that the Regulation itself keeps separate, which settles issue \#34: this model's dcItLoadGw is the
            Article 2(14) concept, while ENTSO-E's published 12.7/9.9 GW figures are closer to the Article 2(15) concept.}
}

